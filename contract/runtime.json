    "actStepsSettleSecs": 3,
    "jsDefaultSecs": 10,
    "jsMaxSecs": 300,
    "jsExtensionGraceSecs": 12,
    "openDefaultSecs": 15,
    "openExtensionGraceSecs": 14,
    "waitDefaultSecs": 30,
    "waitMaxSecs": 300,
    "waitExtensionGraceSecs": 8,
    "shotFilesSecs": 120,
    "batchMaxSecs": 600,
    "batchExtensionWatchdogMs": 580000,
    "toolWatchdogMs": 70000,
    "debuggerTaskTimeoutMs": 60000,
    "debuggerQueueTimeoutMs": 600000
  }
}
