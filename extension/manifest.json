{
  "manifest_version": 3,
  "name": "EMA2 - Edge MCP Agent",
  "version": "1.0.0",
  "description": "Connects Edge browser to AI assistants via MCP (WebSocket bridge). Part of the EMA2 project.",
  "permissions": ["tabs", "activeTab", "scripting", "debugger", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EMA2 - Edge MCP Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
