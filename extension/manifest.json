{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "EMA2 - Edge Agent"
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "Connects the user's real Edge browser to local AI agents over a loopback WebSocket. Part of EMA2.",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "EMA2 - Edge Agent",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "webRequest",
    "storage",
    "alarms"
  ],
  "version": "2.4.1.1"
}
