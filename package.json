{
  "name": "ema2-tests",
  "private": true,
  "version": "1.12.1",
  "description": "Regression tests for the EMA2 extension and relay",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:js": "node --test tests/*.test.cjs",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml --locked --offline",
    "test:edge": "node tests/integration/edge-acceptance.cjs",
    "test:all": "npm run test:js && npm run test:rust"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
